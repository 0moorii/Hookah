[Unit]
Description=Python SNMP host metrics agent
After=network.target

[Service]
Type=simple
User=snmp-agent
Group=snmp-agent
WorkingDirectory=/opt/snmp-python-agent
ExecStart=/opt/snmp-python-agent/.venv/bin/python /opt/snmp-python-agent/snmp_agent.py --config /var/lib/snmp-python-agent/config.json --state-file /var/lib/snmp-python-agent/system.json
StateDirectory=snmp-python-agent
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
