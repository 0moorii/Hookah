#!/bin/sh
# Default to the editable configuration shipped beside the Agent.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1
if [ -n "${HOOKAH_PYTHON:-}" ]; then
    exec "$HOOKAH_PYTHON" -B "$ROOT/snmp_agent.py" --config "$ROOT/snmp_agent_config.json" "$@"
elif [ -x "$ROOT/.venv/bin/python" ]; then
    exec "$ROOT/.venv/bin/python" -B "$ROOT/snmp_agent.py" --config "$ROOT/snmp_agent_config.json" "$@"
else
    exec python3 -B "$ROOT/snmp_agent.py" --config "$ROOT/snmp_agent_config.json" "$@"
fi
